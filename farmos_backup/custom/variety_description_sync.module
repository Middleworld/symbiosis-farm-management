<?php

/**
 * @file
 * Syncs field_variety_description to base description field.
 */

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_entity_presave().
 */
function variety_description_sync_entity_presave(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'taxonomy_term' && $entity->bundle() === 'plant_type') {
    // Sync custom field to base description
    if ($entity->hasField('field_variety_description') && !$entity->get('field_variety_description')->isEmpty()) {
      $custom_description = $entity->get('field_variety_description')->value;
      $custom_format = $entity->get('field_variety_description')->format;
      
      // Update base description field
      $entity->set('description', [
        'value' => $custom_description,
        'format' => $custom_format,
      ]);
    }
  }
}
