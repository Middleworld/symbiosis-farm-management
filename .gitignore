# System and cache directories
logs/
.cache/
.ssh/
.composer/cache/
.wp-cli/cache/
.config/psysh/

# Machine-specific files (never commit)
.viminfo
.composer/
.nodenv/

# Plesk system files
.imunify_patch_id
.myimunify_id
.php-ini
.php-version
public/
web/

# Backups
wordpress-backups/
farmos_backup/

# Environment files (keep .env.example)
.env
!**/.env.example
*.env.backup*
cookies.txt

# Vendor and dependencies
**/vendor/
**/node_modules/

# IDE
.idea/
.vscode/
**/__pycache__/

# Temporary files
**/*.log
**/*.tmp
**/.DS_Store

# WordPress specific
httpdocs/wp-content/uploads/
httpdocs/wp-content/upgrade/
httpdocs/wp-content/cache/

# Laravel specific
admin.soilsync.shop/storage/logs/
admin.soilsync.shop/storage/framework/cache/
admin.soilsync.shop/storage/framework/sessions/
admin.soilsync.shop/storage/framework/views/
admin.soilsync.shop/bootstrap/cache/*.php

# farmOS specific
farmos.soilsync.shop/web/sites/default/files/
farmos.soilsync.shop/web/sites/*/files/private/

# Test/cleanup scripts
admin.soilsync.shop/cleanup-*.php
admin.soilsync.shop/test-*.php
httpdocs/debug-*.php
httpdocs/force-*.php

# OAuth credentials (sensitive)
farmos.soilsync.shop/oauth-credentials-*.txt

# FieldKit (separate installation)

# WordPress additional themes/templates (not custom)
httpdocs/wp-content/themes/blockbase/
httpdocs/wp-content/themes/twentytwentyfive/templates/archive-product.html
httpdocs/wp-content/themes/twentytwentyfive/woocommerce/
httpdocs/wp-content/themes/middleworld-farms/js/
